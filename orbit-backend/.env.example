# Copy this file to .env and fill in real values before running the server.

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (see README for how to get one)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/orbit?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=30d

# bcrypt
BCRYPT_SALT_ROUNDS=10

# Where the browser is sent back to once an OAuth connector flow finishes.
# Should match the frontend's dev server URL.
FRONTEND_URL=http://localhost:5173

# 32-byte key (64 hex chars) used to encrypt OAuth tokens at rest.
# Generate one with: openssl rand -hex 32
OAUTH_ENCRYPTION_KEY=

# --- Google OAuth (Gmail, Google Calendar, Google Drive) ---
# From Google Cloud Console → APIs & Services → Credentials.
# One OAuth Client covers all three connectors (they just request different
# scopes), so they share one Client ID/secret and one redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/oauth/google/callback

# --- GitHub OAuth ---
# From GitHub → Settings → Developer settings → OAuth Apps.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4000/oauth/github/callback
